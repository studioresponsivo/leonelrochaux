# Copie para .env (na VPS) e preencha. NUNCA commite o .env — o repositório é público.

# Subdomínio do bot (DNS tipo A apontando para o IP da VPS). A URL pública vira https://<DOMINIO>
DOMINIO=ig.seudominio.com.br

# Painel da Meta → seu app → Instagram → "Configuração da API com login do Instagram" → Gerar token
IG_TOKEN=

# Mesma tela: "Chave secreta do app do Instagram". Pode acrescentar, separada por vírgula,
# a "Chave secreta do app" de Configurações do app > Básico — o bot aceita qualquer uma das duas.
APP_SECRET=

# Você inventa (ex.: openssl rand -hex 16). O mesmo texto vai no campo "Verificar token" do webhook.
VERIFY_TOKEN=

# Senha do CLI (ig.mjs). Gere com: openssl rand -hex 24
ADMIN_TOKEN=

# Varredura de comentários (segundos; 0 desliga). Garante a automação antes do App Review e se um webhook falhar.
POLL_SEGUNDOS=120
# Quantos posts recentes a varredura olha
POLL_POSTS=5
# Intervalo aleatório entre ações, em ms (ritmo humano)
ATRASO_MS=2000-8000
# Versão da Graph API
GRAPH_VERSION=v25.0
